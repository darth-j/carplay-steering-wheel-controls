+    public static void updateCarPlayCallState(CallState[] callStateArray, int validity) {
+        if (validity != 1) return;
+        int phase = 0;
+        if (callStateArray != null) {
+            for (int i = 0; i < callStateArray.length; ++i) {
+                CallState state = callStateArray[i];
+                if (state == null) continue;
+                System.out.println("MFW CALL_STATE status=" + state.getStatus() + " direction=" + state.getDirection());
+                if (state.getStatus() == 3 && state.getDirection() == 0) {
+                    phase = 1;
+                    break;
+                }
+                if (state.getStatus() == 1 || state.getStatus() == 2 || state.getStatus() == 3) {
+                    phase = 2;
+                }
+            }
+        }
+        carPlayCallPhase = phase;
+        System.out.println("MFW CALL_PHASE " + phase);
+    }
+
+    private boolean isCarPlayActive() {
+        boolean active = this.fwServices.getSysApp().getChoiceModelApp(1122).getValue() == 1;
+        if (!active) carPlayCallPhase = 0;
+        return active;
+    }
+
+    private boolean isCarPlayScreen() {
+        int screenId = this.fw.getHMIService().getCurrentScreenID();
+        System.out.println("MFW SCREEN " + screenId);
+        return screenId == -2136407296 || screenId == 240000;
+    }
+
+    private void handleCustomKey(int keyId) {
+        System.out.println("MFW ACTION " + keyId);
+        if (!this.isCarPlayActive()) {
+            if (keyId == 50) this.openDeviceSelection();
+            return;
+        }
+        int phase = carPlayCallPhase;
+        if (phase == 1) {
+            if (keyId == 58) this.sendCarPlayButton(13);
+            else if (keyId == 52) this.sendCarPlayButton(14);
+            else if (keyId == 50) this.requestCarPlayUI();
+            return;
+        }
+        if (phase == 2) {
+            if (keyId == 52) this.sendCarPlayButton(14);
+            else if (keyId == 50) this.requestCarPlayUI();
+            return;
+        }
+        if (keyId == 50) {
+            if (this.isCarPlayScreen()) {
+                this.requestSiri();
+            }
+            else {
+                this.requestCarPlayUI();
+            }
+            return;
+        }
+        if (!this.isCarPlayScreen()) return;
+        ConnectionPlaybackPolicy.userTransportRequested();
+        if (keyId == 57) { CarPlayAudioFocus.togglePlayback(); return; }
+        if (!CarPlayAudioFocus.hasFocus()) CarPlayAudioFocus.request();
+        if (keyId == 58) this.sendCarPlayButton(9);
+        else if (keyId == 57) this.sendCarPlayButton(15);
+        else if (keyId == 52) this.sendCarPlayButton(10);
+    }
+
+    private void openDeviceSelection() {
+        this.fw.getHMIService().fireSMEvent(0, 107);
+        this.fw.getHMIService().fireSMEvent(0, 1909);
+    }
+
+    private boolean sendCarPlayButton(int buttonId) {
+        return this.runTerminalModeCommand("postButton(CarplayId)", String.valueOf(buttonId));
+    }
+
+    private boolean requestSiri() {
+        return CarPlayAudioFocus.siri();
+    }
+
+    private boolean requestCarPlayUI() {
+        return this.runTerminalModeCommand("requestUI", "");
+    }
+
+    private boolean runTerminalModeCommand(String command, String argument) {
+        if (CarPlayAudioFocus.command(command, argument)) return true;
+        System.out.println("MFW COMMAND_FALLBACK " + command);
+        BundleContext bundleContext = this.fw.getBundleCxt();
+        ServiceReference serviceReference = bundleContext.getServiceReference(SwDiagnosisManager.class.getName());
+        if (serviceReference == null) {
+            System.out.println("MFW NO_DIAG_SERVICE");
+            return false;
+        }
+        try {
+            Object object = bundleContext.getService(serviceReference);
+            if (object instanceof SwDiagnosisManager) {
+                Object result = ((SwDiagnosisManager)object).processCommand(32, command, argument);
+                System.out.println("MFW DIAG_RESULT " + result);
+                return !(result instanceof Number) || ((Number)result).intValue() == 0;
+            }
+        }
+        catch (Throwable throwable) {
+            System.out.println("MFW DIAG_FAILED " + throwable);
+            return false;
+        }
+        finally {
+            bundleContext.ungetService(serviceReference);
+        }
+        return false;
     }
 
